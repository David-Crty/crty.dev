---
import '../styles/global.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import ThemeScript from '../components/ThemeScript.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ts';
import { getPosts } from '../lib/posts.ts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  noindex?: boolean;
}

const { title = site.title, description = site.description, type = 'website', published, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const showWriting = (await getPosts()).length > 0;
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="crty.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Courtey, site reliability engineer, with a rainbow tape rising across a black sleeve" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:creator" content={site.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="crty.dev · Writing" href="/rss.xml" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <div class="site" id="top">
      <a class="skip label" href="#main">Skip to content</a>
      <div class="wrap">
        <TopBar showWriting={showWriting} />
        <main id="main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <script>
      // The content is on screen before the motion is even fetched.
      const boot = () => setTimeout(() => import('../motion/index.ts'), 120);
      if (document.readyState === 'complete') boot();
      else addEventListener('load', boot, { once: true });
    </script>
  </body>
</html>
