---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, postDate } from '../../lib/posts.ts';
import { site } from '../../data/site.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<Base title={`${post.data.title} · ${site.name}`} description={post.data.description}>
  <article>
    <header class="page-head">
      <div class="spec label">
        <time datetime={post.data.date.toISOString()}>{postDate(post.data.date, 'long')}</time> · {minutes} min read{post.data.draft && ' · Draft'}
      </div>
      <h1 class="post-h1">{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="rule"></div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="post-foot label"><a href="/blog/">All writing →</a></div>
  </article>
</Base>
